const NAV_LINKS = [
  ['#producto', 'Producto'],
  ['#industrias', 'Industrias'],
  ['#dte', 'DTE'],
  ['#precios', 'Precios'],
  ['#descargar', 'Descargar'],
  ['#contacto', 'Contacto'],
];

const VC_COMPARE = [
  ['Base de datos', 'Neon PostgreSQL (nube)', 'PostgreSQL en tu PC'],
  ['Internet requerido', 'Siempre', 'Solo al emitir DTE'],
  ['Precio', 'Por paquetes DTE', 'Licencia única'],
  ['Multi-sucursal', '✓ Nativo', 'Con configuración'],
  ['Backup', 'Automático en nube', 'ZIP manual local'],
  ['Módulos premium', 'Incluidos en plan', 'Activados remotamente'],
  ['Activación', 'Web o descarga', 'Wizard + licencia'],
];

const HERO_BARS = [42, 64, 50, 88, 70, 95, 75];
const PS_BARS = [42, 64, 50, 88, 70, 95, 75, 60];

const WA_URL = 'https://wa.me/50300000000?text=Hola%2C%20me%20interesa%20Polaris%20Enterprise';
const WEB_APP = 'https://polaris-web-sooty.vercel.app';
const RELEASE_PAGE = 'https://github.com/Developer545/polaris-releases/releases/latest';
const CLOUD_FALLBACK = 'https://github.com/Developer545/polaris-releases/releases/download/v1.0.4/Polaris-Cloud-1.0.4-win-x64.exe';
const LOCAL_FALLBACK = 'https://github.com/Developer545/polaris-releases/releases/download/v1.0.4/Polaris-Local-1.0.4-win-x64.exe';
---
<!DOCTYPE html>
<html lang="es-SV" class="pal-mercurio">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Polaris Enterprise — POS + DTE para El Salvador</title>
  <meta name="description" content="Punto de venta y facturación electrónica DTE para empresas salvadoreñas. Sin renta mensual — solo pagás los DTE que emitís." />

  <link rel="canonical" href="https://polaris-landing-mu.vercel.app/" />

  <meta property="og:type" content="website" />
  <meta property="og:title" content="Polaris Enterprise — POS + DTE para El Salvador" />
  <meta property="og:description" content="Punto de venta y facturación electrónica DTE. Sin renta mensual — solo pagás los DTE que emitís." />
  <meta property="og:site_name" content="Polaris Enterprise" />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content="Polaris Enterprise — POS + DTE para El Salvador" />
  <meta name="twitter:description" content="Software de gestión empresarial y facturación DTE para negocios salvadoreños." />

  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Instrument+Serif:ital@0;1&family=Plus+Jakarta+Sans:wght@400;600;700&family=DM+Mono:wght@400&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/styles.css" />

  <script is:inline>
    // Habilita estados de animación solo cuando hay JS; evita FOUC de tema.
    document.documentElement.classList.add('js');
    try {
      if (localStorage.getItem('polaris-theme') === 'noche') {
        document.documentElement.classList.replace('pal-mercurio', 'pal-noche');
      }
    } catch (e) {}
  </script>
</head>
<body>

  <!-- ── NAV ─────────────────────────────────────────────── -->
  <nav class="nav" id="nav">
    <div class="nav-inner">
      <a href="#" class="nav-brand">
        <svg viewBox="0 0 100 100" width="28" height="28" aria-hidden="true" style="color:#f47920;flex-shrink:0">
          <path fill="currentColor" d="M50,2 L56,36 L67,33 L64,44 L98,50 L64,56 L67,67 L56,64 L50,98 L44,64 L33,67 L36,56 L2,50 L36,44 L33,33 L44,36 Z" />
          <path fill="rgba(0,0,0,.3)" d="M50,50 L50,2  L56,36 Z" />
          <path fill="rgba(0,0,0,.3)" d="M50,50 L67,33 L64,44 Z" />
          <path fill="rgba(0,0,0,.3)" d="M50,50 L98,50 L64,56 Z" />
          <path fill="rgba(0,0,0,.3)" d="M50,50 L67,67 L56,64 Z" />
          <path fill="rgba(0,0,0,.3)" d="M50,50 L50,98 L44,64 Z" />
          <path fill="rgba(0,0,0,.3)" d="M50,50 L33,67 L36,56 Z" />
          <path fill="rgba(0,0,0,.3)" d="M50,50 L2,50  L36,44 Z" />
          <path fill="rgba(0,0,0,.3)" d="M50,50 L33,33 L44,36 Z" />
          <g fill="none" stroke="rgba(255,255,255,.55)" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
            <path d="M46,40 L44,36 L46,14" /><path d="M60,46 L64,44 L82,46" />
            <path d="M54,60 L56,64 L54,86" /><path d="M40,54 L36,56 L18,54" />
            <path d="M56,40 L60,36 L65,33" /><path d="M60,58 L64,61 L67,65" />
            <path d="M44,60 L40,63 L35,66" /><path d="M40,42 L36,38 L33,34" />
          </g>
          <g fill="rgba(255,255,255,.7)">
            <circle cx="44" cy="36" r="2.5" /><circle cx="64" cy="44" r="2.5" />
            <circle cx="56" cy="64" r="2.5" /><circle cx="36" cy="56" r="2.5" />
            <circle cx="60" cy="36" r="1.7" /><circle cx="64" cy="61" r="1.7" />
            <circle cx="40" cy="63" r="1.7" /><circle cx="36" cy="38" r="1.7" />
          </g>
        </svg>
        <span>Polaris<span class="it"> Enterprise</span></span>
      </a>
      <div class="nav-links">
        {NAV_LINKS.map(([href, label]) => <a href={href}>{label}</a>)}
      </div>
      <div class="nav-cta-group">
        <a class="nav-login" href={WEB_APP} target="_blank" rel="noopener">Iniciar sesión</a>
        <button class="dark-toggle" id="darkToggle" aria-label="Cambiar tema" title="Modo oscuro">
          <span class="dt-track"><span class="dt-thumb"></span></span>
          <span class="dt-icon">☽</span>
        </button>
        <a class="btn btn-ink" href="#descargar">Descargar <span class="arrow">→</span></a>
        <button class="nav-hamburger" id="navHamburger" aria-label="Menú" aria-expanded="false">
          <span></span><span></span><span></span>
        </button>
      </div>
    </div>
    <div class="nav-mobile-menu" id="navMobileMenu">
      {NAV_LINKS.map(([href, label]) => <a href={href}>{label}</a>)}
      <div class="nav-mobile-ctas">
        <a class="btn btn-ghost" href={WEB_APP} target="_blank" rel="noopener">Iniciar sesión</a>
        <a class="btn btn-ink" href="#descargar">Descargar <span class="arrow">↓</span></a>
      </div>
    </div>
  </nav>

  <!-- ── HERO ────────────────────────────────────────────── -->
  <header class="hero">
    <div class="aurora-orbs" aria-hidden="true">
      <div class="aurora-orb ao-1"></div>
      <div class="aurora-orb ao-2"></div>
      <div class="aurora-orb ao-3"></div>
    </div>
    <div class="container">
      <div class="hero-grid">
        <div>
          <div class="hero-meta" data-fx style="--fx:.05s">
            <span class="pill"><span class="pulse"></span>Validado Hacienda · 2024</span>
            <span class="meta-line"></span>
            <span class="kicker">SV · POS + DTE</span>
          </div>

          <h1 class="display">
            <span class="line" data-fx style="--fx:.12s">Tu negocio,</span>
            <span class="line" data-fx style="--fx:.22s"><em>con norte.</em></span>
          </h1>

          <div class="hero-sub-wrap" data-fx style="--fx:.34s">
            <span class="bracket">¶</span>
            <p class="hero-sub">
              El punto de venta y facturación electrónica que las empresas salvadoreñas
              <em class="italic-serif" style="color:var(--ink)"> sí entienden.</em> Desde la
              tiendita de la esquina hasta cadenas con varias sucursales — mismo software, configuración
              a la medida.
            </p>
          </div>

          <div class="hero-cta" data-fx style="--fx:.44s">
            <a href={CLOUD_FALLBACK} class="btn btn-ink" data-dl="cloud" download rel="noopener">
              Cloud para Windows <span class="dl-meta" data-dl-meta>(v1.0.4)</span> <span class="arrow">↓</span>
            </a>
            <a href={LOCAL_FALLBACK} class="btn btn-outline" data-dl="local" download rel="noopener">
              Local para Windows <span class="dl-meta" data-dl-meta>(v1.0.4)</span> <span class="arrow">↓</span>
            </a>
            <a class="btn btn-ghost" href={WEB_APP} target="_blank" rel="noopener">Abrir versión web <span class="arrow">→</span></a>
          </div>

          <div class="hero-trust-row" data-fx style="--fx:.54s">
            <span class="trust-item">Sin tarjeta de crédito</span>
            <span class="trust-item">Instalación 2 min</span>
            <span class="trust-item">Funciona offline</span>
            <span class="trust-item">Soporte en SV</span>
          </div>

          <div class="scroll-indicator" data-fx style="--fx:.7s">
            <span>scroll</span>
            <div class="scroll-indicator-line"></div>
          </div>
        </div>

        <div style="position:relative" data-fx style="--fx:.3s">
          <div class="mockup-frame">
            <div class="mockup-chrome">
              <div class="dots"><span></span><span></span><span></span></div>
              <div class="url">app.polarisenterprise.com/panel</div>
            </div>
            <div class="mockup-body">
              <div class="mk-rail">
                <div class="mk-rail-logo">
                  <svg viewBox="0 0 100 100" width="16" height="16" aria-hidden="true"><path fill="currentColor" d="M50,2 L56,36 L67,33 L64,44 L98,50 L64,56 L67,67 L56,64 L50,98 L44,64 L33,67 L36,56 L2,50 L36,44 L33,33 L44,36 Z" /></svg>
                </div>
                <div class="mk-rail-item active" title="Panel">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><rect x="3" y="3" width="7" height="9"/><rect x="14" y="3" width="7" height="5"/><rect x="14" y="12" width="7" height="9"/><rect x="3" y="16" width="7" height="5"/></svg>
                </div>
                <div class="mk-rail-item" title="POS">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.7 13.4a2 2 0 0 0 2 1.6h9.7a2 2 0 0 0 2-1.6L23 6H6"/></svg>
                </div>
                <div class="mk-rail-item" title="DTE">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M4 2v20l3-2 3 2 3-2 3 2 3-2 1 2V2l-1 2-3-2-3 2-3-2-3 2-3-2z"/><line x1="9" y1="9" x2="15" y2="9"/><line x1="9" y1="13" x2="15" y2="13"/></svg>
                </div>
                <div class="mk-rail-item" title="Inventario">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/><polyline points="3.27 6.96 12 12.01 20.73 6.96"/></svg>
                </div>
                <div class="mk-rail-item" title="Equipo">
                  <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                </div>
              </div>
              <div class="mk-canvas">
                <div class="mk-canvas-top">
                  <div class="mk-pagename">
                    <span class="crumb">Panel</span>
                    <span class="crumb-sep">/</span>
                    <span>Hoy</span>
                  </div>
                  <div class="mk-actions">
                    <span class="mk-act">Filtrar</span>
                    <span class="mk-act primary">+ Nueva venta</span>
                  </div>
                </div>
                <div class="mk-kpis">
                  <div class="mk-kpi">
                    <div class="mk-kpi-label">Ventas hoy</div>
                    <div class="mk-kpi-val">$2,840</div>
                    <div class="mk-kpi-delta">↑ 12%</div>
                  </div>
                  <div class="mk-kpi">
                    <div class="mk-kpi-label">DTE emitidos</div>
                    <div class="mk-kpi-val">34</div>
                    <div class="mk-kpi-delta">↑ 8%</div>
                  </div>
                  <div class="mk-kpi">
                    <div class="mk-kpi-label">Ticket promedio</div>
                    <div class="mk-kpi-val">$83.50</div>
                    <div class="mk-kpi-delta" style="color:var(--ink-3)">= 0%</div>
                  </div>
                  <div class="mk-kpi">
                    <div class="mk-kpi-label">Por cobrar</div>
                    <div class="mk-kpi-val">$1,240</div>
                    <div class="mk-kpi-delta" style="color:var(--accent-2)">↓ 4%</div>
                  </div>
                </div>
                <div class="mk-chart-card">
                  <div class="mk-chart-head">
                    <span class="mk-chart-title">Ventas por hora</span>
                    <span class="mk-chart-range">07:00 — 19:00</span>
                  </div>
                  <div class="mk-chart">
                    {HERO_BARS.map((h, i) => (
                      <div class={'mk-bar' + (h > 80 ? ' warm' : i % 2 ? ' hi' : '')} style={`height:${h}%`}></div>
                    ))}
                  </div>
                </div>
              </div>
            </div>
          </div>
          <div class="mockup-tickets">
            <div class="ticket" data-fx style="--fx:.9s">
              <div class="tk-icon">✓</div>
              <div class="tk-body">
                <div class="tk-id">DTE-01-00234</div>
                <div class="tk-total">$245.30</div>
              </div>
            </div>
            <div class="ticket" data-fx style="--fx:1.1s">
              <div class="tk-icon">✓</div>
              <div class="tk-body">
                <div class="tk-id">DTE-03-00089</div>
                <div class="tk-total">$1,820.00</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </header>

  <!-- ── MARQUEE ─────────────────────────────────────────── -->
  <div class="marquee-wrap">
    <div class="marquee" style="animation-duration:32s">
      {MARQUEE.map((t) => (
        <span class="marquee-item">
          <span class="glyph">✦</span>
          <span>{t}</span>
        </span>
      ))}
    </div>
  </div>

  <!-- ── STATS ───────────────────────────────────────────── -->
  <div class="stats-section">
    <div class="container">
      <div class="stats-grid" data-reveal-group>
        {STATS.map((s) => (
          <div class="stat-item">
            <div class="stat-num">
              <span data-count={s.num} data-decimals={s.dec}>{s.dec ? s.num.toFixed(s.dec) : s.num.toLocaleString('es-SV')}</span>{s.suffix}
            </div>
            <div class="stat-label">{s.label}</div>
            <div class="stat-sub">{s.sub}</div>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- ── LOGO WALL ───────────────────────────────────────── -->
  <div class="logo-wall">
    <div class="container">
      <p class="logo-wall-eyebrow" data-reveal>Negocios salvadoreños que ya usan Polaris Enterprise</p>
      <div class="logo-wall-grid" data-reveal-group>
        {LOGOS.map((l) => (
          <div class="logo-tile">
            <span class="logo-tile-sector">{l.sector}</span>
            <span class="logo-tile-name">{l.name}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- ── BENTO / PRODUCTO ────────────────────────────────── -->
  <section class="section" id="producto">
    <div class="container">
      <div class="section-head" data-reveal>
        <div class="meta">
          <span class="num">01</span>
          <span class="label">/ Producto</span>
        </div>
        <div>
