  <script>
    import { gsap } from 'gsap';
    import { ScrollTrigger } from 'gsap/ScrollTrigger';
    gsap.registerPlugin(ScrollTrigger);

    const reduceMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;

    /* ── Barra de progreso: acompaña el scroll de punta a punta ── */
    gsap.to('#scrollProgress', {
      scaleX: 1,
      ease: 'none',
      scrollTrigger: { start: 0, end: 'max', scrub: 0.3 },
    });

    /* ── Reveal bidireccional: entra al bajar, revierte al subir ── */
    document.querySelectorAll('[data-reveal], [data-reveal-group]').forEach((el) => {
      if (el.hasAttribute('data-reveal-group')) {
        Array.from(el.children).forEach((child, i) => {
          (child as HTMLElement).style.setProperty('--rd', `${Math.min(i * 0.07, 0.6)}s`);
        });
      }
      ScrollTrigger.create({
        trigger: el,
        start: 'top 88%',
        onEnter: () => el.classList.add('is-in'),
        onLeaveBack: () => el.classList.remove('is-in'),
      });
    });

    /* ── Cosmos: ensamblaje orbital con scrub (pin + reversible) ── */
    if (!reduceMotion && document.querySelector('.cosmos')) {
      // Posiciones dispersas de arranque por planeta (índice = data-cplanet)
      const SCATTER = [
        { x: -260, y: -170, r: -70, s: 0.45 },
        { x: 240, y: -200, r: 55, s: 0.4 },
        { x: 280, y: 170, r: 80, s: 0.5 },
        { x: -300, y: 40, r: -60, s: 0.4 },
        { x: -250, y: 200, r: -45, s: 0.35 },
        { x: 300, y: -60, r: 70, s: 0.45 },
        { x: 160, y: 240, r: 100, s: 0.45 },
        { x: 40, y: -240, r: 40, s: 0.4 },
      ];

      const tl = gsap.timeline({
        scrollTrigger: {
          trigger: '.cosmos',
          start: 'top top',
          end: '+=170%',
          scrub: 1,
          pin: true,
          anticipatePin: 1,
        },
        defaults: { ease: 'power2.inOut' },
      });

      tl.from('.cosmos-head', { y: 60, autoAlpha: 0, duration: 0.5 }, 0)
        .from('[data-cplanet]', {
          x: (i) => SCATTER[i].x,
          y: (i) => SCATTER[i].y,
          rotation: (i) => SCATTER[i].r,
          scale: (i) => SCATTER[i].s,
          autoAlpha: 0.35,
          duration: 1.4,
          stagger: 0.12,
        }, 0.1)
        .from('[data-corbit]', {
          attr: { 'stroke-dashoffset': 100 },
          autoAlpha: 0,
          duration: 0.8,
          stagger: 0.15,
        }, 1.1)
        .from('[data-ccore]', { scale: 0, autoAlpha: 0, duration: 0.6, ease: 'back.out(2)' }, 1.4)
        .from('[data-clabel]', { y: 14, autoAlpha: 0, duration: 0.35, stagger: 0.07 }, 1.7)
        .from('[data-ccaption]', { y: 20, autoAlpha: 0, duration: 0.4 }, 1.9);
    }

    /* ── CountUp en stats ─────────────────────────────────── */
    const statsIO = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (!e.isIntersecting) continue;
        statsIO.unobserve(e.target);
        e.target.querySelectorAll('[data-count]').forEach((node) => {
          const to = parseFloat((node as HTMLElement).dataset.count || '0');
          const dec = parseInt((node as HTMLElement).dataset.decimals || '0', 10);
          const t0 = performance.now();
          const dur = 1400;
          const tick = (t: number) => {
            const p = Math.min(1, (t - t0) / dur);
            const eased = 1 - Math.pow(1 - p, 3);
            const v = to * eased;
            node.textContent = dec > 0 ? v.toFixed(dec) : Math.round(v).toLocaleString('es-SV');
            if (p < 1) requestAnimationFrame(tick);
          };
          requestAnimationFrame(tick);
        });
      }
    }, { threshold: 0.3 });
    const statsSection = document.querySelector('.stats-section');
    if (statsSection) statsIO.observe(statsSection);

    /* ── Nav: estado scrolled + menú móvil ───────────────── */
    const nav = document.getElementById('nav');
    let scrolledState = false;
    addEventListener('scroll', () => {
      const s = scrollY > 10;
      if (s !== scrolledState) {
        scrolledState = s;
        nav?.classList.toggle('scrolled', s);
      }
    }, { passive: true });

    const hamburger = document.getElementById('navHamburger');
    const mobileMenu = document.getElementById('navMobileMenu');
    hamburger?.addEventListener('click', () => {
      const open = mobileMenu?.classList.toggle('open');
      hamburger.classList.toggle('open', !!open);
      hamburger.setAttribute('aria-expanded', String(!!open));
    });
    mobileMenu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => {
      mobileMenu.classList.remove('open');
      hamburger?.classList.remove('open');
    }));

    /* ── Tema oscuro ─────────────────────────────────────── */
    const darkToggle = document.getElementById('darkToggle');
    const syncToggle = () => {
      const dark = document.documentElement.classList.contains('pal-noche');
      darkToggle?.classList.toggle('dark-toggle-on', dark);
      const icon = darkToggle?.querySelector('.dt-icon');
      if (icon) icon.textContent = dark ? '☀' : '☽';
    };
    syncToggle();
    darkToggle?.addEventListener('click', () => {
      const html = document.documentElement;
      const dark = html.classList.contains('pal-noche');
      html.classList.replace(dark ? 'pal-noche' : 'pal-mercurio', dark ? 'pal-mercurio' : 'pal-noche');
      try { localStorage.setItem('polaris-theme', dark ? 'mercurio' : 'noche'); } catch (e) {}
      syncToggle();
    });

    /* ── FAQ accordion ───────────────────────────────────── */
    document.querySelectorAll('.faq-item').forEach((item) => {
      item.querySelector('.faq-trigger')?.addEventListener('click', () => {
        const wasOpen = item.classList.contains('open');
        document.querySelectorAll('.faq-item.open').forEach((o) => o.classList.remove('open'));
        if (!wasOpen) item.classList.add('open');
      });
    });

    /* ── Descargas: versión real desde GitHub Releases ───── */
    /* Solo la versión Cloud es descarga pública; Polaris Local se
       entrega como instalador personalizado generado por cliente. */
    const RELEASE_API = 'https://api.github.com/repos/Developer545/polaris-releases/releases/latest';
    fetch(RELEASE_API)
      .then((r) => (r.ok ? r.json() : null))
      .then((data) => {
        if (!data?.assets) return;
        const asset = data.assets.find((a: any) => {
          const n = (a.name || '').toLowerCase();
          return n.endsWith('.exe') && (n.includes('cloud') || !n.includes('local'));
        });
        if (!asset) return;
        const size = asset.size ? `${Math.round(asset.size / 1024 / 1024)} MB` : '';
        document.querySelectorAll('[data-dl="cloud"]').forEach((a) => {
          (a as HTMLAnchorElement).href = asset.browser_download_url;
          const meta = a.querySelector('[data-dl-meta]');
          if (meta) meta.textContent = `(${data.tag_name || ''}${size ? ' · ' + size : ''})`;
        });
      })
      .catch(() => {});
  </script>
