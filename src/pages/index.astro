  { label: 'Compras',      cls: 'cp-ice',   size: 52, x: 10, y: 46, ring: false, fd: 7.5, fdel: 2,   hideSm: false },
  { label: 'Planilla',     cls: 'cp-sage',  size: 56, x: 25, y: 76, ring: false, fd: 8,   fdel: 1.6, hideSm: false },
  { label: 'Contabilidad', cls: 'cp-rose',  size: 60, x: 89, y: 27, ring: false, fd: 9.5, fdel: 0.3, hideSm: true },
  { label: 'Restaurante',  cls: 'cp-teal',  size: 48, x: 60, y: 86, ring: false, fd: 7.2, fdel: 2.4, hideSm: true },
  { label: 'Reportes',     cls: 'cp-slate', size: 44, x: 42, y: 8,  ring: false, fd: 8.8, fdel: 1,   hideSm: false },
];
// Campo de estrellas determinista (mismas posiciones en cada build)
const STARS = Array.from({ length: 70 }, (_, i) => {
  const rnd = (n: number) => {
    const v = Math.sin(i * 127.1 + n * 311.7) * 43758.5453;
    return v - Math.floor(v);
  };
  return {
    x: +(rnd(1) * 100).toFixed(2),
    y: +(rnd(2) * 100).toFixed(2),
    s: +(1 + rnd(3) * 1.8).toFixed(2),
    d: +(2.5 + rnd(4) * 4).toFixed(2),
  };
});

